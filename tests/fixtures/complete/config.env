# The complete configuration, spelled as a .env file, and read with `split("__")`.
#
# Uses an export prefix, quoted values, a name filled in from an earlier line, a comment sharing a
# line with a value, and a name with no value, so the reader has to handle every shape .env offers.
#
# A value holding a space needs quotes around it: unquoted, a value ends at the first one.
#
# Five of the fixture's fields are beyond the format, for two reasons, and `tests/dotenv.rs` names
# them all.
#
# `database.replicas`, `owners`, and the file entry under `logging.targets` each want a table inside
# a list, and a flat list of names has no way to say one: a name holds one value, and saying it
# twice replaces that value rather than adding to a list. This is INI's gap for the same reason.
#
# `server.headers` and the `beta-ui` feature want a hyphen in a key. A .env name is a shell variable
# name, which is letters, digits, underscores, and dots, so there is no writing one.

NAME='Compote — ünïcode ✓'
RELEASED=2026-08-28
MILESTONES='2026-01-01, 2026-06-15'
TAGS='api, web'

# No value. An empty string fills an empty list and an empty map alike.
NOTES=
OWNERS=
EXTRA=

SERVER__BACKLOG=-1
SERVER__HOST=0.0.0.0
SERVER__MAX_BODY_BYTES=4294967296
SERVER__PORT=8443
SERVER__HEADERS=

SERVER__TLS__CIPHERS='TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384'
SERVER__TLS__ENABLED=true
SERVER__TLS__MIN_VERSION=1.3

# An earlier name fills in a later one, which is the one thing read from outside the line.
export DATABASE__HOST=localhost
DATABASE__URL=postgres://${DATABASE__HOST}/compote
DATABASE__POOL__IDLE_TIMEOUT=30.5
DATABASE__POOL__MAX=32
DATABASE__POOL__MIN=4
DATABASE__REPLICAS=

FEATURES__METRICS__ENABLED=true
FEATURES__METRICS__ROLLOUT=1.0
FEATURES__TRACING__ENABLED=false
FEATURES__TRACING__ROLLOUT=0.0

LOGGING__LEVEL=info  # the level, said on the same line as a comment
LOGGING__TARGETS=stdout
