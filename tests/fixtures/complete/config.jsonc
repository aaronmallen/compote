// The complete configuration, spelled in JSON with comments.
//
// Line comments, block comments, and trailing commas all appear, so the reader has to tolerate
// every liberty JSONC takes over plain JSON.
{
  /* Identity */
  "name": "Compote — ünïcode ✓",
  "released": "2026-08-28",
  "milestones": ["2026-01-01", "2026-06-15"],
  "notes": [], // nothing worth saying yet
  "tags": ["api", "web"],
  "extra": {},

  // Everything the listener needs.
  "server": {
    "backlog": -1, // -1 asks the operating system to pick
    "host": "0.0.0.0",
    "max_body_bytes": 4294967296,
    "port": 8443,
    "headers": {
      "x-greeting": "hello\tworld",
      "x-powered-by": "compote", // trailing comma below is legal here
    },
    "tls": {
      /* Only the suites we are willing to negotiate. */
      "ciphers": [
        "TLS_AES_128_GCM_SHA256",
        "TLS_AES_256_GCM_SHA384", // and a trailing comma in an array
      ],
      "enabled": true,
      "min_version": "1.3",
    },
  },

  "database": {
    "url": "postgres://localhost/compote",
    "pool": { "idle_timeout": 30.5, "max": 32, "min": 4 },
    "replicas": [
      { "host": "replica-1.internal", "port": 5432, "weight": 0.75 },
      { "host": "replica-2.internal", "port": 5433, "weight": 0.25 },
    ],
  },

  "features": {
    "beta-ui": { "enabled": true, "rollout": 5e-2 },
    "metrics": { "enabled": true, "rollout": 1.0 },
    "tracing": { "enabled": false, "rollout": 0.0 },
  },

  "logging": {
    "level": "info",
    "targets": [
      "stdout",
      { "file": { "path": "/var/log/compote.log", "rotate": true } },
    ],
  },

  "owners": [
    { "email": "hello@aaronmallen.me", "name": "Aaron" },
    /* Ops has no address on file. */
    { "email": null, "name": "Ops" },
  ],
}
