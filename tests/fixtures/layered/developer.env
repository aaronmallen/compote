# Layer 5. What one developer exports into their own shell.
#
# The file a `.env` lives to be: the same names the process environment uses, kept on disk, read
# just beneath it so a real export still wins.

# Only this layer says it, so it survives to the end.
APP_SERVER__HEADERS__X_REQUEST_ID=from-the-dotenv

# The environment sets this too, and the environment is read after.
APP_SERVER__MAX_BODY_BYTES=1

# Not configuration. It names where configuration lives, so it is ignored by name.
APP_CONFIG=/etc/compote/config.toml
